{
  "name": "prism",
  "displayName": "Prism - PR Safety Mentor",
  "description": "AI-powered PR safety mentor for junior developers",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prism.analyzeMyPR",
        "title": "Prism: Analyze My PR",
        "icon": "$(search)"
      },
      {
        "command": "prism.refreshAnalysis",
        "title": "Refresh Analysis",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prism-sidebar",
          "title": "Prism PR Safety",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "prism-sidebar": [
        {
          "id": "prism.analysisView",
          "name": "PR Analysis",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "prism.refreshAnalysis",
          "when": "view == prism.analysisView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Prism",
      "properties": {
        "prism.defaultTargetBranch": {
          "type": "string",
          "default": "",
          "description": "Default branch to compare against (e.g., develop, main). Leave empty to auto-detect."
        },
        "prism.protectedBranches": {
          "type": "array",
          "default": ["main", "master"],
          "description": "Branches that should not be coded on directly. Changes on these branches will trigger a rescue prompt.",
          "items": {
            "type": "string"
          }
        },
        "prism.ollamaModel": {
          "type": "string",
          "default": "llama3.2:3b",
          "description": "Ollama model to use for AI explanations (e.g., llama3.2:3b, qwen2.5-coder:7b)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  }
}
