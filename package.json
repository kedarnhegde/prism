{
  "name": "prism-ai",
  "displayName": "Prism - PR Safety Mentor",
  "description": "Catch issues before code review. Local-first PR analysis with secrets detection, risk warnings, and smart checklists.",
  "version": "0.1.0",
  "publisher": "prism-ai",
  "author": {
    "name": "Kedar Hegde"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kedarnhegde/prism"
  },
  "bugs": {
    "url": "https://github.com/kedarnhegde/prism/issues"
  },
  "homepage": "https://github.com/kedarnhegde/prism#readme",
  "keywords": [
    "git",
    "pull request",
    "pr",
    "code review",
    "security",
    "secrets detection",
    "ci/cd",
    "testing",
    "quality",
    "mentor",
    "junior developer",
    "best practices"
  ],
  "icon": "resources/logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onView:prism.analysisView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prism.analyzeMyPR",
        "title": "Prism: Analyze My PR",
        "icon": "$(search)"
      },
      {
        "command": "prism.refreshAnalysis",
        "title": "Refresh Analysis",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prism-sidebar",
          "title": "Prism PR Safety",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "prism-sidebar": [
        {
          "id": "prism.analysisView",
          "name": "PR Analysis",
          "type": "webview",
          "icon": ""
        }
      ]
    },
    "menus": {
      "view/title": []
    },
    "configuration": {
      "title": "Prism",
      "properties": {
        "prism.defaultTargetBranch": {
          "type": "string",
          "default": "",
          "description": "Default branch to compare against (e.g., develop, main). Leave empty to auto-detect."
        },
        "prism.protectedBranches": {
          "type": "array",
          "default": [
            "main",
            "master"
          ],
          "description": "Branches that should not be coded on directly. Changes on these branches will trigger a rescue prompt.",
          "items": {
            "type": "string"
          }
        },
        "prism.ollamaModel": {
          "type": "string",
          "default": "llama3.2:3b",
          "description": "Ollama model to use for AI explanations (e.g., llama3.2:3b, qwen2.5-coder:7b)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "simple-git": "^3.22.0"
  }
}
